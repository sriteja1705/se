minikube start --driver=docker

Run kubectl create deployment web-nginx --image=nginx --replicas=2
Run kubectl expose deployment web-nginx --type=NodePort --port=80

Run kubectl scale deployment web-nginx --replicas=4 (or your set's replica count)

Run kubectl get pods
kubectl get svc

Run minikube service web-nginx and keep the terminal open

Run docker run -d --name nagios -p 8090:80 jasonrivers/nagios:latest
http://localhost:8090

docker rm -f nagios
kubectl delete svc web-nginx deployment web-nginx
docker ps
kubectl get pods
